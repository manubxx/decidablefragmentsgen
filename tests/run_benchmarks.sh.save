#!/bin/bash

# ==============================================================================
# CONFIGURAZIONE BENCHMARK
# ==============================================================================
DATASETS_DIR="./ff_datasets"
RESULTS_FILE="./benchmark_results.csv"

# Se hai scaricato vampire su linux/WSL, assicurati che questo comando lo trovi.
# Se è nel tuo PATH, basta "vampire". Altrimenti metti il percorso completo
# (es: VAMPIRE_EXEC="../utils/vampire-Windows-X64/vampire")
VAMPIRE_EXEC="vampire" 

# Timeout in secondi (300 = 5 minuti, come nella tesi del tuo collega)
TIMEOUT=300 

# Inizializza il file CSV con l'intestazione
echo "Dataset,FileName,SZS_Status,Time_Elapsed(s)" > "$RESULTS_FILE"

echo "========================================================"
echo " INIZIO BENCHMARKING VAMPIRE SUL FRAMMENTO FLUTED"
echo " Timeout impostato a: $TIMEOUT secondi"
echo " Risultati salvati in: $RESULTS_FILE"
echo "========================================================"

# Cicla su tutte le sottocartelle dei dataset
for folder in "$DATASETS_DIR"/*; do
    if [ -d "$folder" ]; then
        dataset_name=$(basename "$folder")
        echo "[*] Analizzo Dataset: $dataset_name"

        # Cicla su tutti i file .p nella cartella
        for file in "$folder"/*.p; do
            # Salta se non trova file (caso in cui la cartella sia vuota)
            [ -e "$file" ] || continue
            
            filename=$(basename "$file")
            echo -n "    -> Test di $filename ... "

            # Esegue Vampire e cattura l'output
            # L'opzione -t imposta il timeout rigido
            output=$($VAMPIRE_EXEC -t $TIMEOUT "$file" 2>&1)
            exit_code=$?

            # ==========================================
            # PARSING DELL'OUTPUT DI VAMPIRE
            # ==========================================
            # Estrae lo stato SZS (es. Unsatisfiable, Timeout)
            szs_status=$(echo "$output" | grep -oP '(?<=SZS status )\w+' | head -n 1)
            
            # Estrae il tempo di esecuzione (es. 0.034)
            time_elapsed=$(echo "$output" | grep -oP '(?<=Time elapsed:elapsed=$TIMEOUT
               else
                    szs
